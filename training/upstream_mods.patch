+def scripted_actions(raw, kind):
+    """Scripted defenders from simulator state (what a tag localizer + tracker would provide)."""
+    speed = raw.cfg.command.max_lin_speed
+    att_pos, att_vel = raw._attacker_states()
+    alive = raw._attacker_alive  # (E, A)
+    E, A = alive.shape
+    D = raw.cfg.num_defenders
+    def_pos = torch.stack([d.data.root_pos_w for d in raw._defenders], dim=1)  # (E, D, 3)
+    rel = att_pos.unsqueeze(1) - def_pos.unsqueeze(2)  # (E, D, A, 3)
+    safe = kind.endswith("-safe")
+    kind = kind.removesuffix("-safe")
+    guard = kind == "assign-guard"
+    lead = kind in ("lead", "assign-lead", "assign-guard")
+    if lead:
+        ttg, aim = _intercept(rel, att_vel.unsqueeze(1).expand_as(rel), speed)
+    else:
+        ttg, aim = torch.linalg.norm(rel, dim=-1) / speed, rel
+    dead = ~alive.unsqueeze(1).expand(E, D, A)
+    ttg = torch.where(dead, torch.full_like(ttg, 1e4), ttg)
+
+    if kind.startswith("assign"):
+        combos = _assignments(D, A, raw.device)  # (K, D)
+        K = combos.shape[0]
+        cost_per = torch.gather(ttg.unsqueeze(1).expand(E, K, D, A), 3, combos.view(1, K, D, 1).expand(E, K, D, 1)).squeeze(-1)
+        # distinct targets used vs how many could be covered: every duplicate while a live attacker is unmatched is penalised
+        onehot = torch.nn.functional.one_hot(combos, A).sum(1).clamp(max=1)  # (K, A)
+        covered = (onehot.unsqueeze(0) * alive.unsqueeze(1)).sum(-1)  # (E, K)
+        need = torch.minimum(alive.sum(-1, keepdim=True), torch.tensor(D, device=raw.device))
+        cost = cost_per.max(-1).values + 0.01 * cost_per.sum(-1) + 1e3 * (need - covered).clamp(min=0)
+        target = combos[cost.argmin(-1)]  # (E, D)
+    else:
+        target = ttg.argmin(-1)  # (E, D) nearest / soonest live attacker
+
+    if guard:
+        # goalkeeper: stand on the attacker->site line at guard_r, ram (lead) once the attacker is within 1 m of that spot
+        site = raw.scene.env_origins.clone()
+        site[:, 2] += raw.cfg.site_height * 0.5
+        guard_r = 2.5
+        out = att_pos - site.unsqueeze(1)  # (E, A, 3)
+        out_xy = out.clone()
+        out_xy[..., 2] = 0.0
+        unit = out_xy / torch.clamp(torch.linalg.norm(out_xy, dim=-1, keepdim=True), min=1e-6)
+        gpt = site.unsqueeze(1) + unit * guard_r
+        gpt[..., 2] = att_pos[..., 2]
+        to_guard = gpt.unsqueeze(1) - def_pos.unsqueeze(2)  # (E, D, A, 3)
+        near = (torch.linalg.norm(att_pos - gpt, dim=-1) < 1.0) | (torch.linalg.norm(out_xy, dim=-1) < guard_r)
+        aim = torch.where(near.unsqueeze(1).unsqueeze(-1), aim, to_guard)
+        # slow down when already on the spot (don't overshoot)
+    actions = {}
+    def_alive = getattr(raw, "_defender_alive", torch.ones(E, D, dtype=torch.bool, device=raw.device))
+    for i, agent in enumerate(raw.cfg.possible_agents):
+        a = aim[torch.arange(E, device=raw.device), i, target[:, i]]
+        n = torch.linalg.norm(a, dim=-1, keepdim=True)
+        if guard:
+            # holding the spot: proportional within 0.5 m (no oscillation); ramming: always full speed
+            ramming = near[torch.arange(E, device=raw.device), target[:, i]].unsqueeze(-1)
+            direction = a / torch.where(ramming, n.clamp(min=1e-6), n.clamp(min=0.5))
+        else:
+            direction = a / torch.clamp(n, min=1e-6)
+        if safe:
+            # push away from live teammates closer than 0.8 m (stronger the closer), then renormalise
+            for j in range(D):
+                if j == i:
+                    continue
+                away = def_pos[:, i] - def_pos[:, j]
+                d = torch.linalg.norm(away, dim=-1, keepdim=True).clamp(min=1e-3)
+                w = (2.0 * (0.8 - d) / 0.8).clamp(min=0.0) * def_alive[:, j:j + 1].float()
+                direction = direction + w * away / d
+            direction = direction / torch.clamp(torch.linalg.norm(direction, dim=-1, keepdim=True), min=1.0)
+        actions[agent] = torch.cat([direction, torch.zeros(E, 1, device=raw.device)], dim=-1)
+    return actions
+
