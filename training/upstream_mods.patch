+def _intercept(rel, v_att, speed):
+    """Time and aim point to reach a constant-velocity target at `speed` (rel = target - self).
+
+    Solves |rel + v_att t| = speed t for the smallest t > 0; falls back to the target's current
+    position (t = |rel| / speed) when the target is too fast to catch.
+    """
+    a = (v_att * v_att).sum(-1) - speed**2
+    b = 2.0 * (rel * v_att).sum(-1)
+    c = (rel * rel).sum(-1)
+    direct = torch.sqrt(c) / speed
+    disc = b * b - 4.0 * a * c
+    sq = torch.sqrt(torch.clamp(disc, min=0.0))
+    safe_a = torch.where(a.abs() < 1e-6, torch.full_like(a, -1e-6), a)
+    t1, t2 = (-b - sq) / (2.0 * safe_a), (-b + sq) / (2.0 * safe_a)
+    big = torch.full_like(t1, float("inf"))
+    t = torch.minimum(torch.where(t1 > 0, t1, big), torch.where(t2 > 0, t2, big))
+    ok = (disc >= 0) & torch.isfinite(t)
+    t = torch.where(ok, t, direct)
+    aim = torch.where(ok.unsqueeze(-1), rel + v_att * t.unsqueeze(-1), rel)
+    return t, aim
+
+
+def _assignments(num_defenders, num_attackers, device):
+    """Every defender->attacker mapping (with repeats), shape (K, num_defenders)."""
+    import itertools
+
+    return torch.tensor(list(itertools.product(range(num_attackers), repeat=num_defenders)), device=device)
+
